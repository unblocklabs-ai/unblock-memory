{
  "name": "@unblocklabs/unblock-memory",
  "version": "0.7.2",
  "description": "Workspace-native memory for OpenClaw, powered by QMD",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unblocklabs-ai/unblock-memory.git"
  },
  "homepage": "https://github.com/unblocklabs-ai/unblock-memory#readme",
  "bugs": {
    "url": "https://github.com/unblocklabs-ai/unblock-memory/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "src/mlx-query-worker.py",
    "src/query_contract.py",
    "src/query-tokenizer",
    "skills",
    "README.md",
    "docs/configuration.md",
    "docs/retrieval.md",
    "docs/peoplesql.md",
    "docs/response-audit.md",
    "docs/memory-training.md",
    "docs/extraction.md",
    "openclaw.plugin.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "knip": "knip --reporter compact",
    "test": "npm run test:node && npm run test:python",
    "test:node": "node --import tsx --test --test-concurrency=1 tests/**/*.test.ts tests/**/*.test.mjs",
    "test:python": "python3 -B tests/prepare-query-training.test.py",
    "eval:retrieval": "node --import tsx eval/retrieval/lab.ts",
    "plugin:inspect": "plugin-inspector check --config plugin-inspector.config.json --no-openclaw",
    "plugin:inspect:runtime": "plugin-inspector check --config plugin-inspector.config.json --no-openclaw --runtime --real-sdk --allow-execute",
    "release:check": "node scripts/check-release-version.mjs",
    "preflight": "npm run knip && npm run build && npm run typecheck && npm test && npm run plugin:inspect && npm run plugin:inspect:runtime && npm pack --dry-run"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "@unblocklabs/qmd": "https://github.com/unblocklabs-ai/qmd/releases/download/v2.11.0/unblocklabs-qmd-2.11.0.tgz",
    "chokidar": "5.0.0",
    "js-tiktoken": "1.0.21",
    "picomatch": "^4.0.5",
    "typebox": "1.3.6"
  },
  "devDependencies": {
    "@openclaw/ai": "2026.8.1",
    "@openclaw/plugin-inspector": "^0.3.10",
    "@types/node": "^24.6.0",
    "@types/picomatch": "^4.0.2",
    "knip": "^6.32.2",
    "openclaw": "2026.8.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "openclaw": ">=2026.8.1-beta.3"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.8.1-beta.3",
      "minGatewayVersion": "2026.8.1-beta.3"
    },
    "build": {
      "openclawVersion": "2026.8.1",
      "pluginSdkVersion": "2026.8.1"
    },
    "install": {
      "npmSpec": "@unblocklabs/unblock-memory",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.8.1-beta.3"
    },
    "release": {
      "publishToClawHub": false,
      "publishToNpm": true
    }
  }
}
