{
  "id": "unblock-memory",
  "name": "Unblock Memory",
  "version": "0.3.10",
  "description": "Indexes, retrieves, and analyzes configured workspace memory with existing QMD vectors.",
  "kind": "memory",
  "activation": { "onStartup": false },
  "skills": ["./skills"],
  "contracts": {
    "tools": [
      "memory_search",
      "memory_get",
      "memory_sync_sessions",
      "memory_sync_status",
      "memory_recluster",
      "memory_list_clusters",
      "memory_fetch_cluster",
      "memory_list_maintenance_tasks",
      "memory_update_maintenance_task",
      "memory_people_inspect",
      "memory_people_update",
      "memory_people_sync"
    ]
  },
  "toolMetadata": {
    "memory_sync_sessions": { "sideEffecting": true },
    "memory_sync_status": { "replaySafe": true },
    "memory_recluster": { "sideEffecting": true },
    "memory_list_clusters": { "replaySafe": true },
    "memory_fetch_cluster": { "replaySafe": true },
    "memory_list_maintenance_tasks": { "replaySafe": true },
    "memory_update_maintenance_task": { "sideEffecting": true },
    "memory_people_inspect": { "replaySafe": true },
    "memory_people_update": { "sideEffecting": true },
    "memory_people_sync": { "sideEffecting": true, "optional": true }
  },
  "uiHints": {
    "keepEmbeddingModelWarm": {
      "label": "Keep Embedding Model Warm",
      "help": "Keep the QMD embedding model resident after first use. Disable to unload it after five minutes without model activity."
    },
    "corpora": {
      "label": "Memory Corpora",
      "help": "Named groups of exact Markdown files, directories, or globs. Relative paths resolve from each agent workspace. Skill files use the isolated skills corpus. Session corpora can expand matching semantic chunks up to maxExpandedTokens."
    },
    "skillWhisperer.enabled": {
      "label": "Skill Whisperer",
      "help": "Suggest at most one semantically relevant configured skill before a user turn. Requires hook conversation access."
    },
    "people.enabled": {
      "label": "PeopleSQL",
      "help": "Maintain an agent-local people store. Disabled by default."
    },
    "people.whisperer.enabled": {
      "label": "People Whisperer",
      "help": "Inject an enabled person's bounded dossier blurb after exact identity matching. Requires hook conversation access."
    },
    "analysis.executable": {
      "label": "Memory Analysis Worker",
      "help": "Optional absolute path to the locally installed unblock-memory-analysis executable."
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "keepEmbeddingModelWarm": {
        "type": "boolean",
        "default": true
      },
      "corpora": {
        "type": "array",
        "minItems": 1,
        "items": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "kind", "paths"],
              "properties": {
                "name": { "type": "string", "pattern": "\\S" },
                "kind": { "const": "files" },
                "paths": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "pattern": "\\S" }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "kind"],
              "properties": {
                "name": { "const": "sessions" },
                "kind": { "const": "sessions" },
                "chatTypes": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "enum": ["channel", "group", "direct"] },
                  "default": ["channel", "group"]
                },
                "maxExpandedTokens": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000,
                  "default": 500
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "kind", "paths"],
              "properties": {
                "name": { "const": "skills" },
                "kind": { "const": "skills" },
                "paths": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "pattern": "\\S" }
                }
              }
            }
          ]
        },
        "default": [
          {
            "name": "memory",
            "kind": "files",
            "paths": ["MEMORY.md", "USER.md", "memory/**/*.md"]
          }
        ]
      },
      "analysis": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "executable": { "type": "string", "minLength": 1 }
        }
      },
      "people": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": false },
          "whisperer": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean", "default": false },
              "maxChars": { "type": "integer", "minimum": 1, "maximum": 4000, "default": 1200 }
            },
            "default": { "enabled": false, "maxChars": 1200 }
          },
          "todos": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "maxOpen": { "type": "integer", "minimum": 1, "maximum": 10000, "default": 1000 }
            },
            "default": { "maxOpen": 1000 }
          }
        },
        "default": {
          "enabled": false,
          "whisperer": { "enabled": false, "maxChars": 1200 },
          "todos": { "maxOpen": 1000 }
        }
      },
      "skillWhisperer": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": false },
          "historyMessages": { "type": "integer", "minimum": 0, "default": 5 },
          "minScore": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 },
          "cooldownTurns": { "type": "integer", "minimum": 0, "default": 10 }
        },
        "default": {
          "enabled": false,
          "historyMessages": 5,
          "minScore": 0.5,
          "cooldownTurns": 10
        }
      }
    }
  }
}
