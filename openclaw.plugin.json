{
  "id": "unblock-memory",
  "name": "Unblock Memory",
  "version": "0.3.12",
  "description": "Indexes, retrieves, and analyzes configured workspace memory with existing QMD vectors.",
  "kind": "memory",
  "activation": { "onStartup": true },
  "skills": ["./skills"],
  "contracts": {
    "tools": [
      "memory_search",
      "memory_get",
      "memory_sync_sessions",
      "memory_sync_status",
      "memory_recluster",
      "memory_list_clusters",
      "memory_fetch_cluster",
      "memory_list_maintenance_tasks",
      "memory_update_maintenance_task",
      "memory_people_inspect",
      "memory_people_update",
      "memory_people_sync"
    ]
  },
  "toolMetadata": {
    "memory_sync_sessions": { "sideEffecting": true },
    "memory_sync_status": { "replaySafe": true },
    "memory_recluster": { "sideEffecting": true },
    "memory_list_clusters": { "replaySafe": true },
    "memory_fetch_cluster": { "replaySafe": true },
    "memory_list_maintenance_tasks": { "replaySafe": true },
    "memory_update_maintenance_task": { "sideEffecting": true },
    "memory_people_inspect": { "replaySafe": true },
    "memory_people_update": { "sideEffecting": true },
    "memory_people_sync": { "sideEffecting": true, "optional": true }
  },
  "uiHints": {
    "typesafe.enabled": {
      "label": "TypeSafe Ranking",
      "help": "Enabled by default when credentials exist. Sends bounded conversation context and skill descriptions or approved memory excerpts to TypeSafe for enabled whisperers."
    },
    "typesafe.apiKey": { "label": "TypeSafe API Key", "sensitive": true },
    "typesafe.apiKeyFile": {
      "label": "TypeSafe Key File",
      "help": "Absolute path to a plaintext API key or a dotenv file containing TYPESAFE_API_KEY. Prefer this over storing a key in config."
    },
    "keepEmbeddingModelWarm": {
      "label": "Keep Embedding Model Warm",
      "help": "Keep the QMD embedding model resident after first use. Disable to unload it after five minutes without model activity."
    },
    "corpora": {
      "label": "Memory Corpora",
      "help": "Named groups of exact Markdown files, directories, or globs. Relative paths resolve from each agent workspace. Skill files use the isolated skills corpus. Session corpora can expand matching semantic chunks up to maxExpandedTokens."
    },
    "skillWhisperer.enabled": {
      "label": "Skill Whisperer",
      "help": "Suggest at most one semantically relevant configured skill before a user turn. Requires hook conversation access."
    },
    "memoryWhisperer.enabled": {
      "label": "Memory Whisperer",
      "help": "Inject up to two TypeSafe-approved historical excerpts before user turns. Requires explicit corpora, a TypeSafe key, and hook conversation access. Disabled by default."
    },
    "memoryWhisperer.corpora": {
      "label": "Approved Hint Corpora",
      "help": "Explicit non-skill corpus allowlist. Approve file corpora for all audiences using this agent and for transmission to TypeSafe. Session hits are restricted to the exact current session."
    },
    "people.enabled": {
      "label": "PeopleSQL",
      "help": "Maintain an agent-local people store. Disabled by default."
    },
    "people.whisperer.enabled": {
      "label": "People Whisperer",
      "help": "Inject an enabled person's bounded dossier blurb after exact identity matching. Requires hook conversation access."
    },
    "analysis.executable": {
      "label": "Memory Analysis Worker",
      "help": "Optional absolute path to the locally installed unblock-memory-analysis executable."
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "keepEmbeddingModelWarm": {
        "type": "boolean",
        "default": true
      },
      "corpora": {
        "type": "array",
        "minItems": 1,
        "items": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "kind", "paths"],
              "properties": {
                "name": { "type": "string", "pattern": "\\S" },
                "kind": { "const": "files" },
                "paths": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "pattern": "\\S" }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "kind"],
              "properties": {
                "name": { "const": "sessions" },
                "kind": { "const": "sessions" },
                "syncIntervalMinutes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1440,
                  "default": 15,
                  "description": "Refresh sessions every N minutes while the Gateway runs; 0 disables automatic sync. First refresh is after one interval."
                },
                "chatTypes": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "enum": ["channel", "group", "direct"] },
                  "default": ["channel", "group"]
                },
                "maxExpandedTokens": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000,
                  "default": 500
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "kind", "paths"],
              "properties": {
                "name": { "const": "skills" },
                "kind": { "const": "skills" },
                "paths": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "pattern": "\\S" }
                }
              }
            }
          ]
        },
        "default": [
          {
            "name": "memory",
            "kind": "files",
            "paths": ["MEMORY.md", "USER.md", "memory/**/*.md"]
          }
        ]
      },
      "analysis": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "executable": { "type": "string", "minLength": 1 }
        }
      },
      "people": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": false },
          "whisperer": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean", "default": false },
              "maxChars": { "type": "integer", "minimum": 1, "maximum": 4000, "default": 1200 }
            },
            "default": { "enabled": false, "maxChars": 1200 }
          },
          "todos": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "maxOpen": { "type": "integer", "minimum": 1, "maximum": 10000, "default": 1000 }
            },
            "default": { "maxOpen": 1000 }
          }
        },
        "default": {
          "enabled": false,
          "whisperer": { "enabled": false, "maxChars": 1200 },
          "todos": { "maxOpen": 1000 }
        }
      },
      "typesafe": {
        "type": "object",
        "additionalProperties": false,
        "not": { "required": ["apiKey", "apiKeyFile"] },
        "properties": {
          "enabled": { "type": "boolean", "default": true },
          "apiKey": { "type": "string", "pattern": "\\S" },
          "apiKeyFile": { "type": "string", "pattern": "\\S" },
          "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 10000, "default": 1500 }
        },
        "default": { "enabled": true, "timeoutMs": 1500 }
      },
      "memoryWhisperer": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": false },
          "corpora": { "type": "array", "items": { "type": "string", "pattern": "\\S" }, "default": [] },
          "historyMessages": { "type": "integer", "minimum": 0, "maximum": 50, "default": 5 },
          "minUsefulness": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.9 },
          "maxHints": { "type": "integer", "minimum": 1, "maximum": 2, "default": 2 },
          "cooldownTurns": { "type": "integer", "minimum": 0, "maximum": 1000, "default": 10 },
          "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 10000, "default": 3000 }
        },
        "default": {
          "enabled": false, "corpora": [], "historyMessages": 5, "minUsefulness": 0.9,
          "maxHints": 2, "cooldownTurns": 10, "timeoutMs": 3000
        }
      },
      "skillWhisperer": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": false },
          "historyMessages": { "type": "integer", "minimum": 0, "default": 5 },
          "minScore": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 },
          "cooldownTurns": { "type": "integer", "minimum": 0, "default": 10 }
        },
        "default": {
          "enabled": false,
          "historyMessages": 5,
          "minScore": 0.5,
          "cooldownTurns": 10
        }
      }
    }
  }
}
