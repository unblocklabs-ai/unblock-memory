{
  "version": 1,
  "plugin": {
    "id": "unblock-memory",
    "priority": "high",
    "seams": ["plugin-runtime"],
    "sourceRoot": "src",
    "expect": {
      "hooks": [
        "before_prompt_build",
        "after_tool_call",
        "message_received",
        "session_end",
        "gateway_stop"
      ],
      "registrations": ["registerCli", "registerMemoryCapability", "registerTool"],
      "manifestContracts": ["tools"]
    }
  },
  "capture": { "mockSdk": true }
}
